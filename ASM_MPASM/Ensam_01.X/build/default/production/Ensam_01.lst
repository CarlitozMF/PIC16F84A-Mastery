2007   3FF1           00009         __CONFIG _FOSC_XT & _WDTE_OFF & _PWRTE_ON & _CP_OFF
                      00010 
                      00011 ;--- CAPA 1: MAPEO DE HARDWARE Y CONSTANTES ---
  00000055            00012 CONSTANTE   EQU     b'01010101'
                      00013 ;   ----    Vector de Reset ----
                      00014         ORG         0                   ;El ptograma comienza en la direccion 0 de la memoria de program
                            a
0000   2???           00015         goto        Inicio              ;Salta la posicion de memoria del vector de interrupcion
                      00016 ;   ----    Vector de Intrrupcion   ----
                      00017         ORG         04h                 ;Direcciion de memoria del vector interrupcio
0004   0009           00018         retfie                          ;Retorna por seguridad
                      00019 ;--- CAPA 2: CONFIGURACIÓN DE PERIFÉRICOS ---
0005   1683           00020 Inicio  bsf         STATUS,RP0          ;Pone en 1 el bit 5 (RP0) de STATUS. Accede al banco 1
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0006   0186           00021         clrf        TRISB               ;Las lineas del puerto B se configuran como salida
0007   1283           00022         bcf         STATUS,RP0          ;Pone en 0 el bit 5 (RP0) de STATUS, Retorna al banco 0
                      00023         
0008   3055           00024         movlw       CONSTANTE           ;Carga el registro de trabajo w con el valor de la cte
                      00025 ;--- CAPA 3: LÓGICA DE APLICACIÓN ---
0009                  00026 Principal
0009   0086           00027         movwf       PORTB               ;El contenido de W se deposita en el puerto de salida
000A   2???           00028         goto        Principal           ;Se crea un blucle cerrado e infinito
                      00029         
3FF1                  00030         END                             ;Fin del Programa
