                      00013 
                      00014 ;--- CAPA 1: MAPEO DE HARDWARE Y CONSTANTES ---
Warning[207]: Found label after column 1. (ENTRADAS)
  0000001F            00015     ENTRADAS    EQU     b'00011111'     ; RA0-RA4 como entradas
Warning[207]: Found label after column 1. (MASCARASW)
  0000001F            00016     MASCARASW   EQU     b'00011111'     ; Mascara para asegurar el uso de los 5 bits de entrada
                      00017 
                      00018     ORG     0x00
0000   2???           00019     GOTO    INICIO
                      00020 
                      00021     ORG     0x04
0004   0009           00022     RETFIE                          ; Resguardo de interrupciones
                      00023 ;--- CAPA 2: CONFIGURACIÓN DE PERIFÉRICOS ---
0005                  00024 INICIO
0005   1683           00025     BSF     STATUS, RP0             ; Acceso al Banco 1
0006   301F           00026     MOVLW   ENTRADAS
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0007   0085           00027     MOVWF   TRISA                   ; Configuro Puerto A
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0008   0186           00028     CLRF    TRISB                   ; Puerto B como salida completa
0009   1283           00029     BCF     STATUS, RP0             ; Regreso al Banco 0
                      00030     
000A   0186           00031     CLRF    PORTB                   ; Aseguro salidas en 0 al iniciar
                      00032 
                      00033 ;--- CAPA 3: LÓGICA DE APLICACIÓN ---
000B                  00034 MAIN
000B   0805           00035     MOVF    PORTA,W                 ;Guardo en W los datos de entrada de PORTA
000C   391F           00036     ANDLW   MASCARASW               ;Mascara de filtro para los 5 bits de entrada
000D   0086           00037     MOVWF   PORTB                   ;Vuelco los valores de W con mascara en el PORTB
000E   0063           00038     SLEEP                           ;Entra en modo stanby eterno
000F                  00039 SEGURO
