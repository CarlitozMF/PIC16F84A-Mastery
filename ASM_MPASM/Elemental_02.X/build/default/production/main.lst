                      00012 
                      00013 ;--- CAPA 1: MAPEO DE HARDWARE Y CONSTANTES ---
Warning[207]: Found label after column 1. (ENTRADAS)
  0000001F            00014     ENTRADAS    EQU     B'00011111'  ; RA0-RA4 como entradas
                      00015 
                      00016     ORG     0x00
0000   2???           00017     GOTO    INICIO
                      00018 
                      00019     ORG     0x04
0004   0009           00020     RETFIE                          ; Resguardo de interrupciones
                      00021 ;--- CAPA 2: CONFIGURACIÓN DE PERIFÉRICOS ---
0005                  00022 INICIO
0005   1683           00023     BSF     STATUS, RP0             ; Acceso al Banco 1
0006   301F           00024     MOVLW   ENTRADAS
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0007   0085           00025     MOVWF   TRISA                   ; Configuro Puerto A
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0008   0186           00026     CLRF    TRISB                   ; Puerto B como salida completa
0009   1283           00027     BCF     STATUS, RP0             ; Regreso al Banco 0
                      00028     
000A   0186           00029     CLRF    PORTB                   ; Aseguro salidas en 0 al iniciar
                      00030 
                      00031 ;--- CAPA 3: LÓGICA DE APLICACIÓN ---
000B                  00032 MAIN
000B   0805           00033     MOVF    PORTA,W                 ;Guardo en W los datos de las entradas en PORTA
000C   0705           00034     ADDWF   PORTA,W                 ;Aqui es donde sumo PORTA + PORTA(W) y lo guardo en W
000D   0086           00035     MOVWF   PORTB                   ;Vuelco los datos de PORTA en PORTB
000E   2???           00036     goto    MAIN                    ;Creo un bucle cerrado e infinito
                      00037     
3FF9                  00038     END                             ;Fin del Programa
